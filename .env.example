# Supabase → Project Settings → API (или «Ключи API»)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# publishable / anon ключ (публичный)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# secret / service_role ключ (СЕКРЕТНЫЙ — только на сервере, никому не показывать)
SUPABASE_SERVICE_ROLE_KEY=
# Название школы в шапке сайта
NEXT_PUBLIC_SITE_NAME=Онлайн-школа
